# What this deployment calls itself, and the block a new athlete's form opens on.
#
# Copy to `.env` (already gitignored) and edit. Every line is optional: with no `.env` at
# all the app builds the block this repository ships with — La Mitja de Granollers, Mon
# 17 Aug 2026 to Sun 24 Jan 2027, sub-1:20.
#
# These are BUILD-TIME values. Vite compiles them into the Worker and into the client
# bundle (`src/lib/config.ts`), so changing one needs a rebuild and a redeploy — `pnpm
# deploy` — not a restart. A blank value (`PUBLIC_HR_MAX=`) counts as absent and falls
# back to the default; a malformed one fails the build on purpose rather than quietly
# producing a plan for the wrong year.
#
# None of this is secret — a race date and a goal time are printed on the start list.
# Secrets live in `.dev.vars` locally and in `wrangler secret put` on the deployed
# Worker: see `.dev.vars.example`.
#
# Two things a `.env` cannot move, and a fork has to edit by hand:
#   - the 23 weeks of sessions in `src/lib/seed.ts` — one athlete's plan, in Spanish
#     (or write your own through the MCP server on POST /api/mcp);
#   - the previous season's CSV exports in `docs/personal/data/` — delete them and the comparison
#     against last season simply goes quiet.

# ---------------------------------------------------------------------------------
# Identity — every name a person reads. Between them these three reach all eight page
# titles, the launch screen, the login screen, `404`, the meta description, the Open
# Graph card and `manifest.webmanifest`. What they do NOT reach is the Spanish prose the
# app is written in, the plan in `src/lib/seed.ts` or the icons: see docs/setup.md §d.
# ---------------------------------------------------------------------------------

# What the app calls itself — the `<title>` of every page and the name of the installed
# app. Distinct from the race below, and on a deployment with several athletes that
# difference is the point: they each race something else, so the name they all share has
# to be the app's, never any one of their events.
# Default: StrideAI
PUBLIC_APP_NAME="StrideAI"

# The home-screen label. iOS gives it about twelve characters before it ellipsises, so
# keep it short — this is the one name somebody else truncates.
# Default: StrideAI
PUBLIC_APP_SHORT_NAME="StrideAI"

# One sentence, read three times: the meta description, the Open Graph card and the
# manifest. Spanish, like everything else on screen.
# Default: Plan, carga y progreso hacia tu próxima carrera, en un único cuaderno.
PUBLIC_APP_DESCRIPTION="Plan, carga y progreso hacia tu próxima carrera, en un único cuaderno."


# ---------------------------------------------------------------------------------
# The block itself — the values the training maths is computed from.
# ---------------------------------------------------------------------------------

# The race, as it is printed on the bib. Becomes the title of the final session.
# Default: La Mitja de Granollers
PUBLIC_RACE_NAME="La Mitja de Granollers"

# Race day, YYYY-MM-DD, read as the athlete's local wall clock. Must fall after
# PUBLIC_BLOCK_START, and at least four weeks after it.
# Default: 2027-01-24
PUBLIC_RACE_DATE=2027-01-24

# Race distance in metres — Strava units, decimals allowed. 21097.5 is the half marathon,
# 42195 the marathon, 10000 a 10K.
# Default: 21097.5
PUBLIC_RACE_DISTANCE_M=21097.5

# The Monday the block opens on, YYYY-MM-DD. Must be a Monday: week indices count from it
# and every week in the plan is BLOCK_START + i * 7 days. Nothing before it is synced.
# Default: 2026-08-17
PUBLIC_BLOCK_START=2026-08-17

# The goal finish time, h:mm:ss (or mm:ss under an hour). Every training pace in
# `src/lib/paces.ts` is a ratio of the pace this implies over PUBLIC_RACE_DISTANCE_M, so
# moving it moves the whole table — easy, long, steady, threshold, race and VO2.
# Default: 1:19:59
PUBLIC_GOAL_TIME=1:19:59

# Maximum heart rate, bpm. The five zone floors are shares of it. Measure it from a race
# or a hard test rather than from 220 − age: an inflated maximum pushes every run down a
# zone. The app never renders a bpm, only the zone it falls in.
# Default: 192
PUBLIC_HR_MAX=192

# Last season's race, YYYY-MM-DD — the anchor the previous build in `docs/personal/data/*.csv` is
# aligned on. Its rows are shifted forward by (PUBLIC_RACE_DATE − this), so both seasons
# read at the same distance from race day. Point it at the previous edition of the same
# race and the shift stays a whole number of weeks, which also keeps every weekday.
# Must fall before PUBLIC_RACE_DATE.
# Default: 2026-01-18
PUBLIC_PREV_RACE_DATE=2026-01-18
