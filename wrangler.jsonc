{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lamitja2027",
  // Custom entrypoint: the Astro adapter honours `main` when we set it, which is
  // how the app's fetch handler and the cron `scheduled` handler share one Worker.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lamitja2027",
      "database_id": "56a4163c-7e29-49fa-9141-996efa9073a0",
      "migrations_dir": "migrations"
    }
  ],

  // CACHE holds one thing: the single-use OAuth state token.
  "kv_namespaces": [{ "binding": "CACHE", "id": "ddbcc843b1204d3cb0df5d8581af8d53" }],

  "triggers": {
    // Nightly safety net; the webhook handles the common case.
    "crons": ["0 3 * * *"]
  },

  // The race, the goal and the block dates are constants in `src/lib/block.ts`, not
  // config — they are compiled into the training maths and never differ per environment.
  "vars": {
    // Not secret: the client ID is public in every OAuth redirect.
    "STRAVA_CLIENT_ID": "183487"
  }
}
