{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Replace with your own — this is the Worker's name and therefore its address,
  // `https://<name>.<your-subdomain>.workers.dev`, which is the host Strava's app-wide
  // callback domain has to match. See docs/setup.md.
  "name": "lamitja2027",
  // Custom entrypoint: the Astro adapter honours `main` when we set it, which is
  // how the app's fetch handler and the cron `scheduled` handler share one Worker.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Replace both `database_name` and `database_id` with your own — `wrangler d1 create
  // <name>` prints the pair, and these are inert against any other Cloudflare account.
  // The `db:*` scripts in package.json address the database by its *binding* (`DB`), which
  // wrangler accepts wherever it takes a database name, so nothing outside this block has
  // to know what you called it. See docs/setup.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lamitja2027",
      "database_id": "56a4163c-7e29-49fa-9141-996efa9073a0",
      "migrations_dir": "migrations"
    }
  ],

  // One bucket, two things in it, and the binding's name is older than the second.
  //
  //   `avatars/<userId>/<version>.<webp|jpg>`   Private profile photos. The browser sends
  //       one already-cropped 512 px WebP and the Worker reads/writes it through this
  //       binding — no public bucket domain and no REST hop.
  //   `exercises/<catalogVersion>/<id>/<pose>.webp`   The RepDB exercise illustrations,
  //       mirrored once by `pnpm exercises:populate` rather than hotlinked: a third-party
  //       origin sits outside the service worker's reach, and this app's whole claim is
  //       that it works at a trailhead with no signal. Same for every athlete, so unlike
  //       an avatar these are not private — only the URL is scoped, by being behind the
  //       default-closed `/api` gate.
  //
  // A second bucket was considered and rejected: it would be another thing every fork and
  // the live deployment must create and bind before the feature works, for no isolation
  // gain (both stores are reachable only through this Worker's own routes) and no
  // bucket-level behaviour we would want to differ. The key namespaces cannot collide.
  // Renaming the binding to match was rejected too — it touches five files and two docs
  // for a purely cosmetic gain.
  //
  // Forks create their own bucket and replace this name; see docs/setup.md.
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "lamitja2027-avatars" }],

  // Every link in the app is written without a trailing slash (`src/lib/nav.ts`), and the
  // build emits `plan/index.html`. Workers Assets' default `auto-trailing-slash` answers
  // `/plan` with a 307 to `/plan/` — so every tab tap, on the app's most-repeated
  // interaction, spent a round trip before the first byte of HTML, and the service worker
  // cached the shell under a path none of the app's own links ask for. Dropping the slash
  // makes `/plan` the canonical address and serves it directly.
  "assets": { "html_handling": "drop-trailing-slash" },

  // CACHE holds one thing: the single-use OAuth state token. Replace the id with your own
  // — `wrangler kv namespace create CACHE`, and see docs/setup.md.
  "kv_namespaces": [{ "binding": "CACHE", "id": "ddbcc843b1204d3cb0df5d8581af8d53" }],

  // Two speed bumps, in front of the two endpoints that take a credential. See
  // `src/lib/ratelimit.ts` for what they are and are not — in short, per-location and
  // eventually consistent, so the real defence is still a long `APP_PASSWORD`.
  //
  // A WAF rate-limiting rule would be the obvious alternative and is not available here:
  // those are configured per zone, and `workers.dev` is not a zone you own. `period` may
  // only be 10 or 60.
  "ratelimits": [
    // A person signs in once per device per year. Eight a minute is generous for the
    // fat-fingered and ruinous for a script.
    { "name": "LOGIN_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    // Higher, because a legitimate caller here is an agent: writing a block through
    // `create_sessions` and reading it back is tens of calls in a burst, not one.
    { "name": "MCP_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  "triggers": {
    // Nightly safety net; the webhook handles the common case.
    "crons": ["0 3 * * *"]
  },

  // The race, the goal and the block dates are *not* here. They are build-time values —
  // `PUBLIC_*` in `.env`, read by `src/lib/config.ts` and compiled into the bundle — because
  // they differ per fork rather than per environment, and because the pure training maths
  // must not need a binding to answer how many weeks the block has. See `.env.example`.
  "vars": {
    // Not secret: the client ID is public in every OAuth redirect. Replace it with your
    // own Strava application's — every deployment has one, and this one's callback domain
    // points at the author's host. docs/setup.md §b.
    "STRAVA_CLIENT_ID": "183487"
  }
}
