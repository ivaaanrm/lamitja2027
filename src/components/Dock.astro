---
import { TABS, type Tab } from '../lib/nav'

/**
 * The tab bar, iPhone-style: fixed to the bottom of the viewport, translucent over
 * whatever is scrolling behind it, and sitting above the home indicator rather than under
 * it.
 *
 * Prerendered into every page rather than rendered by React. It is four links and a
 * highlight — the active tab is known at build time, because a prerendered page can only
 * ever be one of them — so shipping a component to work that out on the client would be
 * JavaScript spent re-deriving a constant.
 *
 * Each tab is a full-height 56px column: on a phone the target is the column, not the
 * glyph, and there is no hover state to lean on.
 */
interface Props {
  tab: Tab
}
const { tab } = Astro.props

// Lucide, inlined. Four icons is less markup than any way of importing them, and it keeps
// the dock a single file with no runtime behind it.
const ICONS: Record<Tab, string> = {
  today: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',
  plan: '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/>',
  progress: '<path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/>',
  log: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
}
---

<nav
  aria-label="Secciones"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-neutral-800/80 bg-neutral-950/75 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl"
>
  <ul class="mx-auto flex max-w-md">
    {
      TABS.map((entry) => {
        const active = entry.key === tab
        return (
          <li class="flex-1">
            <a
              href={entry.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex h-14 flex-col items-center justify-center gap-[3px] transition-opacity active:opacity-60',
                active ? 'text-neutral-100' : 'text-neutral-500',
              ]}
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width={active ? 2.25 : 1.75}
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-[22px]"
                set:html={ICONS[entry.key]}
              />
              <span class:list={['text-[0.625rem] leading-none', active && 'font-semibold']}>
                {entry.label}
              </span>
            </a>
          </li>
        )
      })
    }
  </ul>
</nav>
