---
import App from '../layouts/App.astro'
import { ActivityDetail } from '../components/ActivityDetail'
export const prerender = true
---

{/*
  One shell for every activity: the id is the query string, read by the island once it
  mounts. A route per activity would need the Worker to render it — the pages here are
  prerendered, and `/registro` is the only way in, so the shell is already prefetched.
*/}
<App title="Actividad · La Mitja 2027" heading="Actividad" tab="log">
  <ActivityDetail client:load />
</App>
