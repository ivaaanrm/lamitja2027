---
import App from '../layouts/App.astro'
import { Progress } from '../components/Progress'

// Prerendered shell. Both seasons are derived on the client: this one from /api/data, the
// 2025-26 baseline from the CSVs bundled into `lib/baseline.ts`.
export const prerender = true
---

<App
  title="Progreso · La Mitja 2027"
  heading="Progreso"
  sub="Contra la temporada 2025-26, a la misma distancia de la carrera"
  tab="progress"
>
  <Progress client:load />
</App>
