---
import Base from '../layouts/Base.astro'
import { APP_NAME, APP_SHORT_NAME, GOAL_TIME_S, RACE_DATE } from '../lib/config'
import { formatClock } from '../lib/activity'
export const prerender = true

// Dates are UTC midnight of the local day; formatting in another zone slides them.
const raceDay = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(RACE_DATE))

/**
 * The one screen without a dock, and the app's first impression.
 *
 * It is allowed to breathe where the four tabs may not — this is the only screen in the
 * product with a single decision on it, so the density rules that make a cockpit out of
 * `/` would only make this one look unfinished. The generosity is still spent the same
 * way: inside the card and around the one number, never on the outer grid, which keeps the
 * page gutter every other screen uses.
 *
 * The composition is deliberately the same shape as a `HeroMetric` — an eyebrow, one large
 * number, a line of context under it — because that is the shape the rest of the app opens
 * with and a stranger should be able to tell these are the same product. It is written out
 * here rather than imported: the primitive is a React component, and shipping a runtime to
 * a page whose whole job is two fields and a button would cost more than the four spans it
 * saves.
 *
 * The goal time is ink, not mint. Mint is state in this app — done, now, ahead, the
 * primary action — and the goal is none of those; it is the target. The mint on this
 * screen is spent once, on the button, which is also why the invitation link under the
 * form is quiet: signing in is what this screen is for, and creating an account is the
 * other door.
 *
 * Every word of identity here comes from `config.ts` — the name, the short name in the
 * eyebrow, race day, the hero itself — and that is the *deployment's* block, not the
 * signed-in athlete's. It is the only screen where that is the right reading: nobody is
 * signed in yet. An athlete arriving on an invitation has no goal of their own to show
 * here; `/alta` opens on the invitation instead, and their own numbers are the first thing
 * `/bienvenida` asks for.
 */
---

<Base title={APP_NAME}>
  <main
    class="mx-auto flex min-h-full max-w-sm flex-col justify-center gap-5 px-gutter py-10 pb-[calc(2.5rem+env(safe-area-inset-bottom))]"
  >
    <header class="fade-up">
      {/* The mark is this block's course profile — the app's own trace motif, and the only
          decoration on the screen. It carries no information the text below does not, so
          it is a decorative image with an empty alt. A fork that redraws `favicon.svg`
          replaces it here and nowhere else. */}
      <span
        class="performance-shadow grid size-16 place-items-center rounded-2xl border border-line bg-surface-raised"
      >
        <img src="/favicon.svg" alt="" width="40" height="40" class="size-10" />
      </span>

      <p class="mt-5 text-caption2 font-semibold uppercase tracking-[0.16em] text-label-3">
        {APP_SHORT_NAME} · {raceDay}
      </p>
      <h1 class="mt-2">
        <span class="block text-subhead text-label-2">Tu bloque hacia</span>
        <span class="data-number mt-1 block font-display text-display font-bold leading-none text-label">
          {formatClock(GOAL_TIME_S)}
        </span>
      </h1>
      <p class="mt-3 text-footnote leading-relaxed text-label-2">
        Plan, carga y progreso en un único cuaderno de rendimiento.
      </p>
    </header>

    {/* 30ms behind the header — the stagger the rest of the app reveals lists at, so the
        first thing anyone sees moves the way everything after it will. */}
    <form
      id="login"
      novalidate
      class="performance-shadow fade-up rounded-2xl border border-line bg-surface-raised p-4"
      style="animation-delay: 30ms"
    >
      <label class="block">
        <span class="text-caption2 uppercase tracking-[0.09em] text-label-3">Correo</span>
        {/*
          The same control every form in the app uses (`CONTROL` in ui/index.tsx), one step
          taller: 48px, matching the dock's columns and the button under it, because the
          three targets on this screen should all be the same size.

          `text-body` is 17px and load-bearing — Safari zooms the whole page in on a focused
          input whose text is under 16px, and on a screen with no dock to scroll back to,
          that leaves you sideways with no way back.

          `autocapitalize` and `autocorrect` off: iOS capitalises the first letter of every
          field it is not told about, and an address is stored lowercased — `Marc@…` would
          be typed, sent, and bounced against a row that reads `marc@…`.
        */}
        <input
          id="email"
          type="email"
          name="email"
          autocomplete="email"
          inputmode="email"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="next"
          required
          aria-describedby="error"
          class="motion-standard mt-1.5 h-12 w-full rounded-xl border border-line bg-surface-deep/35 px-3 text-body text-label outline-none transition-colors focus:border-line-strong focus:bg-fill aria-[invalid=true]:border-red"
        />
      </label>

      <label class="mt-3 block">
        <span class="text-caption2 uppercase tracking-[0.09em] text-label-3">Contraseña</span>
        <input
          id="password"
          type="password"
          name="password"
          autocomplete="current-password"
          enterkeyhint="go"
          required
          aria-describedby="error"
          class="motion-standard mt-1.5 h-12 w-full rounded-xl border border-line bg-surface-deep/35 px-3 text-body text-label outline-none transition-colors focus:border-line-strong focus:bg-fill aria-[invalid=true]:border-red"
        />
      </label>

      {/* Under the fields it belongs to, above the button — so the fix is next to the thing
          that needs fixing, and the target the thumb is already over does not move. */}
      <p id="error" role="alert" class="mt-2 hidden text-footnote leading-relaxed text-red"></p>

      <button
        id="submit"
        type="submit"
        class="tappable mt-3 flex h-12 w-full items-center justify-center rounded-xl bg-mint text-body font-semibold text-surface disabled:opacity-40"
      >
        Entrar al bloque
      </button>
    </form>

    {/* The other door, and the only one there is: accounts exist because an admin minted a
        link, so this is a pointer for someone holding one, not an open sign-up. */}
    <p class="fade-up text-center text-footnote text-label-3" style="animation-delay: 60ms">
      ¿Tienes una invitación?
      <a
        href="/alta"
        class="tappable inline-flex min-h-11 items-center px-1 align-middle text-label-2 underline underline-offset-4"
      >
        Crea tu cuenta
      </a>
    </p>
  </main>
</Base>

<script>
  import { clearCachedBlock } from '../lib/net'
  /**
   * The whole screen is one request, so the button is the only place to report it.
   *
   * Three states, and every one of them says something in Spanish: idle, `Entrando…` while
   * the request is out, and a sentence under the fields when it comes back wrong. The
   * version this replaces had none of the second and only one of the third — an unhandled
   * rejection on a dropped connection left the form looking exactly like a form that had
   * never been submitted.
   */
  const form = document.querySelector<HTMLFormElement>('#login')!
  const email = document.querySelector<HTMLInputElement>('#email')!
  const password = document.querySelector<HTMLInputElement>('#password')!
  const button = document.querySelector<HTMLButtonElement>('#submit')!
  const error = document.querySelector<HTMLParagraphElement>('#error')!
  const fields = [email, password]
  const idle = button.textContent

  /** `focus` is where the correction most likely belongs; `also` is marked but not moved to. */
  function fail(message: string, focus: HTMLInputElement, ...also: HTMLInputElement[]) {
    error.textContent = message
    error.classList.remove('hidden')
    // Pairs the red rule on the field with the sentence, so the state is never carried by
    // colour on its own, and puts the caret back where the correction has to happen.
    for (const field of [focus, ...also]) field.setAttribute('aria-invalid', 'true')
    focus.focus()
    focus.select()
  }

  function clearError() {
    error.classList.add('hidden')
    for (const field of fields) field.removeAttribute('aria-invalid')
  }

  // Typing is the fix, so it is also what dismisses the message.
  for (const field of fields) field.addEventListener('input', clearError)

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    clearError()

    // `novalidate` on the form: the browser's own bubble is unstyleable and phrases this
    // in its own words, and an empty field posted straight through would come back as
    // "correo o contraseña incorrectos", which is the wrong thing to tell someone who
    // typed nothing.
    if (!email.value.trim()) return fail('Escribe tu correo para entrar.', email)
    if (!password.value) return fail('Escribe tu contraseña para entrar.', password)

    button.disabled = true
    button.textContent = 'Entrando…'
    form.setAttribute('aria-busy', 'true')

    try {
      // JSON rather than the `FormData` this used to post: the endpoint validates with the
      // same zod schemas as every other write now, and those parse an object, not a
      // multipart body of strings.
      const response = await fetch('/api/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: email.value, password: password.value }),
      })
      if (response.ok) {
        // Whatever the service worker was holding belongs to whoever signed in last, and
        // this device has just changed hands as far as the app is concerned. Dropping it
        // here means the first paint after signing in is this athlete's block or nothing.
        await clearCachedBlock()
        // A document load rather than a client-side navigation: the session cookie has
        // just been set, and every island behind `/` reads it on mount. The button is
        // deliberately left saying `Entrando…` — the page is already on its way out, and
        // flicking it back to its idle label first would read as the attempt failing.
        location.href = '/'
        return
      }
      // The server says which half was wrong to nobody, so neither does this: both fields
      // are marked and the caret goes to the password, which is the half that is retyped.
      fail('Correo o contraseña incorrectos.', password, email)
    } catch {
      // fetch only rejects on a transport failure, so this is "no hay red", never a 401.
      fail('No se ha podido conectar. Vuelve a intentarlo.', password)
    }

    button.disabled = false
    button.textContent = idle
    form.removeAttribute('aria-busy')
  })
</script>
