---
import Base from '../layouts/Base.astro'
export const prerender = true
---

<Base title="La Mitja 2027">
  <main class="mx-auto flex min-h-full max-w-sm flex-col justify-center gap-8 px-4 py-10 pb-[calc(2.5rem+env(safe-area-inset-bottom))]">
    <header class="px-1">
      <span class="performance-shadow grid size-16 place-items-center rounded-2xl border border-line bg-surface-raised">
        <img src="/favicon.svg" alt="" class="size-10" />
      </span>
      <p class="mt-8 text-caption2 font-semibold uppercase tracking-[0.16em] text-label-3">La Mitja · 24 ene 2027</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-[-0.04em]">Tu bloque hacia<br /><span class="data-number">1:19:59</span></h1>
      <p class="mt-3 max-w-xs text-subhead leading-relaxed text-label-2">Plan, carga y progreso en un único cuaderno de rendimiento.</p>
    </header>

    <form id="login" class="performance-shadow space-y-4 rounded-3xl border border-line bg-surface-raised p-5">
      <label class="block">
        <span class="text-caption font-semibold text-label-2">Contraseña</span>
        <input
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="Tu contraseña"
          required
          class="mt-2 h-12 w-full rounded-2xl border border-line bg-surface-deep/35 px-4 text-body outline-none transition-colors placeholder:text-label-3 focus:border-line-strong focus:bg-fill"
        />
      </label>
      <button
        type="submit"
        class="h-12 w-full rounded-2xl bg-mint text-body font-semibold text-surface transition-[transform,opacity] active:scale-[0.98] active:opacity-80"
      >
        Entrar al bloque
      </button>
      <p id="error" role="alert" class="hidden text-footnote text-red"></p>
    </form>
  </main>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#login')!
  const error = document.querySelector<HTMLParagraphElement>('#error')!

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    error.classList.add('hidden')

    const response = await fetch('/api/login', { method: 'POST', body: new FormData(form) })
    if (response.ok) {
      location.href = '/'
      return
    }

    error.textContent = 'Contraseña incorrecta'
    error.classList.remove('hidden')
  })
</script>
