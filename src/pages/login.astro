---
import Base from '../layouts/Base.astro'
export const prerender = true
---

<Base title="La Mitja 2027">
  <main class="mx-auto flex min-h-full max-w-sm flex-col justify-center gap-8 px-6 pb-[env(safe-area-inset-bottom)]">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">La Mitja 2027</h1>
      <p class="text-sm text-neutral-400">Entra para ver tu entrenamiento.</p>
    </header>

    <form id="login" class="space-y-3">
      <input
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="Contraseña"
        required
        class="h-12 w-full rounded-xl border border-neutral-800 bg-neutral-900 px-4 text-base outline-none focus:border-neutral-600"
      />
      <button
        type="submit"
        class="h-12 w-full rounded-xl bg-white text-base font-semibold text-neutral-950 active:opacity-80"
      >
        Entrar
      </button>
      <p id="error" class="hidden text-sm text-red-400"></p>
    </form>
  </main>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#login')!
  const error = document.querySelector<HTMLParagraphElement>('#error')!

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    error.classList.add('hidden')

    const response = await fetch('/api/login', { method: 'POST', body: new FormData(form) })
    if (response.ok) {
      location.href = '/'
      return
    }

    error.textContent = 'Contraseña incorrecta'
    error.classList.remove('hidden')
  })
</script>
