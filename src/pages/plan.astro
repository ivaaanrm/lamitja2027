---
import App from '../layouts/App.astro'
import { Planner } from '../components/Planner'
import { TOTAL_WEEKS } from '../lib/block'

// Prerendered app shell, same as the home page — the plan itself arrives from /api/data.
export const prerender = true
---

<App
  title="Plan · La Mitja 2027"
  heading="Plan"
  sub={`${TOTAL_WEEKS} semanas hasta La Mitja`}
  tab="plan"
>
  <Planner client:load />
</App>
