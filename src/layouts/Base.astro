---
import '../styles/global.css'
import { APP_DESCRIPTION, APP_SHORT_NAME } from '../lib/config'

interface Props {
  title: string
  description?: string
}
// One sentence for the meta description, the Open Graph card and the manifest alike —
// `APP_DESCRIPTION`, so a fork writes it once. A page passes its own only to say something
// this one cannot.
const { title, description = APP_DESCRIPTION } = Astro.props

// Absolute, because Open Graph rejects relative URLs. `site` is set in astro.config.mjs.
const ogImage = new URL('/og.png', Astro.site)
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover is what makes env(safe-area-inset-*) resolve on iPhone -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!--
      iOS's data detectors read a run of digits with separators in it as a phone number and
      restyle it as a blue underlined link, in the system's colour and outside every token
      in this app. A training log is nothing but those runs — `3:47`, `1:29:59`, `24/01`,
      `5 × 1000` — so the detector is turned off rather than fought per screen.
    -->
    <meta name="format-detection" content="telephone=no" />

    <!--
      The two faces the app is set in — Inter for the interface, Manrope for the page
      heading and the one hero number per screen. Both are preloaded because they are
      same-origin and discovered late: the stylesheet has to parse before the browser
      learns they exist, and `font-display: swap` would otherwise flash a fallback through
      first paint on every cold load — on the largest text on the screen, where the reflow
      is the most visible. `crossorigin` is required even same-origin: fonts are fetched in
      CORS mode, and without it the preload is discarded and the file fetched a second time.
    -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- SVG for browsers that take it, .ico for Safari and the bare /favicon.ico request. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!--
      `mobile-web-app-capable` is the standardised name and the one Chrome reads;
      `apple-mobile-web-app-capable` is the deprecated original and is still the only one
      iOS honours, so both are here rather than either.
    -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {/* The home-screen label on iOS, and the one name somebody else truncates: about
        twelve characters before it ellipsises, which is why it is the short form. */}
    <meta name="apple-mobile-web-app-title" content={APP_SHORT_NAME} />
    <!--
      `--color-surface`, written out. A meta tag cannot read a custom property, so this is
      the one place outside the token file where a colour is a literal — keep
      it in step with the token in global.css or Android paints its address bar a shade the
      page never uses. It had drifted to #191b21 against a `--color-surface` of #12151a,
      which is exactly the failure this comment was written to prevent; `background_color`
      and `theme_color` in the manifest are the same value again for the same reason, and
      they are what Android and iOS 16.4+ paint the launch screen with — left at #000 they
      opened every cold start on a black field the app never shows.
      iOS ignores the meta entirely: the status bar there is `black-translucent` above, with
      `body`'s `env(safe-area-inset-top)` holding the content out from under it.
    -->
    <meta name="theme-color" content="#12151a" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      No `<ClientRouter />`, on purpose, and this is the one line in the head worth
      explaining. Tabs used to navigate between documents and Astro's router swapped the
      body to hide it; that swap was itself the stutter, because it tore down the React
      root and rehydrated the incoming shell — which is skeletons — inside the transition.
      The four tabs are one document now (`src/components/Shell.tsx`), so there is nothing
      left for it to swap. What remains are the doors: `/login`, `/alta`, `/bienvenida` and
      `/404`, each entered once, each honestly a new document.
    -->
  </head>
  <!--
    No background of its own: the ground is on `<html>` and the atmosphere above it is a
    fixed pseudo-element behind everything (`global.css`). A `bg-surface` here would sit in
    front of that negative layer and paint it out.
  -->
  <body class="h-full text-label font-sans antialiased">
    <slot />
  </body>
</html>

<script>
  /**
   * The offline layer, hung off every page in the app.
   *
   * A bundled module script, so it runs exactly once per *document* — which is once per
   * launch, since the app shell never leaves the document it opened in. Registering the
   * worker from here rather than from an island is deliberate: `/login` and `/404` have no
   * island at all, and they are precisely the two screens someone lands on with a bad
   * connection.
   *
   * `watchKeyboard` is here for the same reason and answers to the same lifetime: it
   * listens to the *visual* viewport and flags the document root while the software
   * keyboard is up, which is the one thing `position: fixed` cannot see for itself. Every
   * screen with a field on it needs it, dock or no dock.
   */
  import { initPwa } from '../lib/pwa'
  import { watchKeyboard } from '../lib/keyboard'

  initPwa()
  watchKeyboard()
</script>
