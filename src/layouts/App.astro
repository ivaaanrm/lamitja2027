---
import Base from './Base.astro'
import Dock from '../components/Dock.astro'
import type { Tab } from '../lib/nav'

/**
 * The shell every signed-in page wears: one column sized for a phone, a large title that
 * scrolls away with the content, and the dock.
 *
 * The bottom padding is the dock's own height plus the home indicator, so the last card on
 * a page can be scrolled clear of the bar instead of ending underneath it.
 */
interface Props {
  title: string
  heading: string
  sub?: string
  tab: Tab
}
const { title, heading, sub, tab } = Astro.props
---

<Base title={title}>
  <main
    transition:animate="fade"
    class="mx-auto flex min-h-full max-w-lg flex-col gap-4 px-gutter pt-6 pb-[calc(6.5rem+env(safe-area-inset-bottom))]"
  >
    <header class="px-1 pb-1">
      <p class="text-caption2 font-semibold uppercase tracking-[0.16em] text-label-3">
        La Mitja 2027
      </p>
      <h1 class="mt-1 text-2xl font-semibold tracking-[-0.035em] text-label">{heading}</h1>
      {sub ? <p class="mt-1 text-caption text-label-2">{sub}</p> : null}
    </header>
    <slot />
  </main>
  <Dock tab={tab} />
</Base>
