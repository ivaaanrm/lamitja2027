---
import Base from './Base.astro'
import Boot from '../components/Boot.astro'
import { Shell } from '../components/Shell'
import { documentTitle } from '../lib/nav'

/**
 * The prerendered document behind every screen in the app.
 *
 * There is one of these per route under `src/pages`, and they are near-identical on
 * purpose: each is an entry point — a cold start, a deep link, a reload — that paints real
 * HTML for its own screen and then hands the whole app to one React root. Every hop *after*
 * that is a `pushState` inside this document (`src/components/router.tsx`), so the other
 * six shells are never fetched. What they exist for is the first byte of the first paint,
 * and for a phone with no signal opening a URL it has cached.
 *
 * It used to be much more than this: the column, the header, the dock and the bottom
 * padding were all prerendered here, once per page, and `ClientRouter` swapped the body
 * between them. That is what made a tab tap cost a React teardown and a rehydrate against
 * a skeleton. All of it moved into `Shell.tsx`, which is the thing that now owns the
 * column and everything in it.
 *
 * `Boot` stays here, outside the island and last in the body. It is server-rendered
 * precisely so it is in the first paint with no JavaScript behind it, and it is now shown
 * once per *document* for free — there is no body swap left to carry it across.
 */
interface Props {
  /** A key of `ROUTES`. What this document was prerendered for, and what it hydrates as. */
  path: string
}
const { path } = Astro.props
---

<Base title={documentTitle(path)}>
  <Shell path={path} client:load />
  <Boot />
</Base>
