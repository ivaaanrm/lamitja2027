---
import Base from './Base.astro'
import Dock from '../components/Dock.astro'
import type { Tab } from '../lib/nav'

/**
 * The shell every signed-in page wears: one column sized for a phone, a compact title that
 * scrolls away with the content, and the dock.
 *
 * The bottom padding is the dock's own height plus the home indicator, so the last card on
 * a page can be scrolled clear of the bar instead of ending underneath it. 4.75rem is the
 * dock measured, not guessed: a 48px column plus the 4px the bar insets it by, top and
 * bottom, is 3.5rem; the remaining 1.25rem covers the nav's own bottom inset and still
 * leaves a card visibly clear of a bar it would otherwise be blurred through. Both sides
 * add `env(safe-area-inset-bottom)` on top, so they move together on a notched phone —
 * but change `h-12` or `p-1` in `Dock.astro` and this number has to move by hand.
 *
 * The column is tuned for density: cards sit `gap-2` apart rather than a full step, and
 * the heading and its subtitle share one line-box each. The heading is `title2` off the
 * ramp — it used to be `text-2xl`, a size belonging to no scale, and it cost a third of
 * the first screen before a single number appeared.
 *
 * There is no brand eyebrow above the heading any more. It said "La Mitja 2027" on all
 * four tabs, directly above a subtitle that on the home screen already says "La Mitja ·
 * 24 de enero de 2027" — a line of chrome, repeated everywhere, naming the app to the one
 * person who installed it. iOS puts the title first and the app's name on the home-screen
 * icon; so does this now, and every screen starts ~16px higher for it.
 *
 * ---
 *
 * **This column deliberately carries no `transition:name`.** It used to — `name="page"`
 * with a custom cross-fade — and that is what made a tab tap stutter on the phone.
 *
 * A `view-transition-name` lifts an element out of the root snapshot and gives it its own
 * `::view-transition-group`, and the group's job is to animate the element's *box* from
 * where it was to where it lands. Astro writes rules for `old` and `new` only, so that
 * group animation stayed on the browser's default 250ms `ease` — and it had real work to
 * do, because this column is the whole scrolling page:
 *
 *   - The router resets the scroll to the top inside the transition callback. Snapshots
 *     are positioned against the viewport, so a column tapped at 1500px down has its old
 *     box at −1500 and its new box at 0 — and the group dutifully *slid the entire page*
 *     that distance while it faded. Every tap from anywhere but the top of a screen.
 *   - `/registro` is several thousand pixels tall and `/` is one screen, so the same group
 *     interpolated a height between them on every switch.
 *   - Capturing a named element captures all of it, not the part you can see. The old
 *     texture was the full document height rather than the phone's 800 points.
 *
 * Left unnamed, the column is part of the root snapshot instead, which is exactly the
 * viewport — one small texture, no travel, nothing to resize. The cross-fade itself moved
 * to `::view-transition-old(root)` / `-new(root)` in `global.css`, on the same two motion
 * tokens. The dock keeps its own name, so it is still lifted out of that snapshot and
 * still swapped in place rather than fading with the page.
 */
interface Props {
  title: string
  heading: string
  sub?: string
  tab: Tab
}
const { title, heading, sub, tab } = Astro.props
---

<Base title={title}>
  <main
    class="mx-auto flex min-h-full max-w-lg flex-col gap-2 px-gutter pt-3 pb-[calc(4.75rem+env(safe-area-inset-bottom))]"
  >
    <header class="px-0.5 pb-0.5">
      <h1 class="font-display text-title2 font-bold tracking-tight text-label">{heading}</h1>
      {sub ? <p class="mt-0.5 text-footnote leading-relaxed text-label-2">{sub}</p> : null}
    </header>
    <slot />
  </main>
  <Dock tab={tab} />
</Base>
